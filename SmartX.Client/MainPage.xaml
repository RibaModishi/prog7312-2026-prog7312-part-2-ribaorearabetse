<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartX.Client.MainPage"
             Style="{StaticResource SmartXPage}"
             Title="Smart-X Gateway"
             Shell.NavBarIsVisible="False">

    <!--
        The content column is centred and capped rather than stretched, so the cards stay a
        comfortable reading width on a wide desktop window while still collapsing to the full width
        of a narrow phone screen. The cap belongs on the ScrollView: a capped, centred child inside
        a ScrollView is measured against an unconstrained width and overflows the viewport.
    -->
    <ScrollView HorizontalOptions="Center" MaximumWidthRequest="680">
        <VerticalStackLayout Padding="24,32,24,40" Spacing="28">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Border WidthRequest="72"
                        HeightRequest="72"
                        Stroke="{StaticResource SmartXAccent}"
                        BackgroundColor="#10243A"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 16">
                    <Label Text="SX"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource SmartXAccent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="SMART-X OPERATIONS" Style="{StaticResource SectionLabel}" />
                    <Label Text="Smart-X Gateway" Style="{StaticResource PageTitle}" />
                    <Label x:Name="StatusLabel"
                           Style="{StaticResource PageSubtitle}"
                           Text="Signed in. Loading the mesh." />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="14">

                <Border Style="{StaticResource PillarCard}"
                        Stroke="{StaticResource SmartXAccent}"
                        SemanticProperties.Description="Sensor Data Ingestion and Telemetry. Available. Opens the sensor registration screen.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIngestionTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="AVAILABLE"
                               Style="{StaticResource StatusBadge}"
                               TextColor="{StaticResource SmartXAccent}" />
                        <Label Text="Sensor Data Ingestion and Telemetry"
                               Style="{StaticResource PillarTitle}" />
                        <Label Text="Register sensors, ingest telemetry, and monitor the gateway."
                               Style="{StaticResource PillarDescription}" />
                    </VerticalStackLayout>
                </Border>

                <!--
                    The two pillars below are deliberately inert: no gesture recogniser is attached
                    at all, so a stray tap cannot navigate even if the disabled visual state is
                    restyled later.
                -->
                <Border Style="{StaticResource PillarCard}"
                        Stroke="{StaticResource SmartXAccent}"
                        SemanticProperties.Description="Real-Time Command Stream and History. Available.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCommandStreamTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="AVAILABLE"
                               Style="{StaticResource StatusBadge}"
                               TextColor="{StaticResource SmartXAccent}" />
                        <Label Text="Real-Time Command Stream and History"
                               Style="{StaticResource PillarTitle}" />
                        <Label Text="Watch live telemetry, filter devices, and issue pump or relay overrides."
                               Style="{StaticResource PillarDescription}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource PillarCard}"
                        IsEnabled="False"
                        Opacity="0.45"
                        SemanticProperties.Description="Network Topology and Mesh Routing. Not yet available.">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="COMING IN THE FINAL POE" Style="{StaticResource StatusBadge}" />
                        <Label Text="Network Topology and Mesh Routing"
                               Style="{StaticResource PillarTitle}" />
                        <Label Text="Coming in the final Portfolio of Evidence."
                               Style="{StaticResource PillarDescription}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
