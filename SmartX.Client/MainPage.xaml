<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartX.Client.MainPage"
             Style="{StaticResource SmartXPage}"
             Title="Smart-X Gateway"
             Shell.NavBarIsVisible="False">

    <!--
        The content column is centred and capped rather than stretched, so the cards stay a
        comfortable reading width on a wide desktop window while still collapsing to the full width
        of a narrow phone screen. The cap belongs on the ScrollView: a capped, centred child inside
        a ScrollView is measured against an unconstrained width and overflows the viewport.
    -->
    <ScrollView HorizontalOptions="Center" MaximumWidthRequest="720">
        <VerticalStackLayout Padding="28,36,28,48" Spacing="28">

            <Border StrokeThickness="0"
                    HeightRequest="210"
                    StrokeShape="RoundRectangle 24">
                <Grid>
                    <Image Source="greenhouse_hero.jpg"
                           Aspect="AspectFill"
                           HeightRequest="210" />
                    <Border BackgroundColor="#660E1612"
                            StrokeThickness="0"
                            VerticalOptions="End"
                            Padding="16,12">
                        <Label Text="The greenhouse, this evening"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16" />
                    </Border>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="4">
                    <Label Text="SMART-X" Style="{StaticResource SectionLabel}" />
                    <Label Text="Good to see you" Style="{StaticResource PageTitle}" />
                    <Label x:Name="StatusLabel"
                           Style="{StaticResource PageSubtitle}"
                           Text="Checking the greenhouse." />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">

                <Border Style="{StaticResource PillarCard}"
                        Stroke="{StaticResource SmartXAccent}"
                        SemanticProperties.Description="Sensor Data Ingestion and Telemetry. Available. Opens the sensor registration screen.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIngestionTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="88,*" ColumnSpacing="14">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="88">
                            <Image Source="moisture_plant.jpg" Aspect="AspectFill" HeightRequest="88" WidthRequest="88" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="PART 1  ·  OPEN"
                                   Style="{StaticResource StatusBadge}"
                                   TextColor="{StaticResource SmartXAccent}" />
                            <Label Text="Add sensors and watch alerts"
                                   Style="{StaticResource PillarTitle}" />
                            <Label Text="Register a device, attach a file, and see when a reading crosses the line."
                                   Style="{StaticResource PillarDescription}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!--
                    The two pillars below are deliberately inert: no gesture recogniser is attached
                    at all, so a stray tap cannot navigate even if the disabled visual state is
                    restyled later.
                -->
                <Border Style="{StaticResource PillarCard}"
                        Stroke="{StaticResource SmartXAccent}"
                        SemanticProperties.Description="Real-Time Command Stream and History. Available.">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCommandStreamTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="88,*" ColumnSpacing="14">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="88">
                            <Image Source="water_pump.jpg" Aspect="AspectFill" HeightRequest="88" WidthRequest="88" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="PART 2  ·  OPEN"
                                   Style="{StaticResource StatusBadge}"
                                   TextColor="{StaticResource SmartXAccent}" />
                            <Label Text="Run the greenhouse"
                                   Style="{StaticResource PillarTitle}" />
                            <Label Text="See live moisture and power, switch pumps and relays, and undo the last command."
                                   Style="{StaticResource PillarDescription}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PillarCard}"
                        IsEnabled="False"
                        Opacity="0.45"
                        SemanticProperties.Description="Network Topology and Mesh Routing. Not yet available.">
                    <Grid ColumnDefinitions="88,*" ColumnSpacing="14">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="88" Opacity="0.7">
                            <Image Source="quiet_bench.jpg" Aspect="AspectFill" HeightRequest="88" WidthRequest="88" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="LATER" Style="{StaticResource StatusBadge}" />
                            <Label Text="Network map"
                                   Style="{StaticResource PillarTitle}" />
                            <Label Text="Mesh routing arrives in the final portfolio. This room stays closed for now."
                                   Style="{StaticResource PillarDescription}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

