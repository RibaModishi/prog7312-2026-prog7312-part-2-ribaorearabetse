<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Shared Smart-X palette and control styles. Keeping them here rather than inline on each page
    means every screen added later inherits the same spacing, typography and accent colour without
    a second set of magic numbers drifting out of step with this one.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="SmartXBackground">#101614</Color>
    <Color x:Key="SmartXSurface">#1B2922</Color>
    <Color x:Key="SmartXBorder">#31483C</Color>
    <Color x:Key="SmartXAccent">#8FCB9B</Color>
    <Color x:Key="SmartXAccentSoft">#1E3A2A</Color>
    <Color x:Key="SmartXTextPrimary">#F4F7F2</Color>
    <Color x:Key="SmartXTextSecondary">#A8B8AE</Color>
    <Color x:Key="SmartXDanger">#E07A7A</Color>
    <Color x:Key="SmartXWarning">#E2B657</Color>
    <Color x:Key="SmartXFieldBackground">#121C18</Color>

    <Style x:Key="SmartXPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource SmartXBackground}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextSecondary}" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextSecondary}" />
    </Style>

    <Style x:Key="PillarCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SmartXSurface}" />
        <Setter Property="Stroke" Value="{StaticResource SmartXBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="22,20" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Offset="0,10" Radius="24" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillarTitle" TargetType="Label">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextPrimary}" />
    </Style>

    <Style x:Key="PillarDescription" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextSecondary}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextPrimary}" />
    </Style>

    <Style x:Key="FieldHint" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextSecondary}" />
    </Style>

    <Style x:Key="FormEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource SmartXFieldBackground}" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource SmartXTextSecondary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="FormPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource SmartXFieldBackground}" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SmartXAccent}" />
        <Setter Property="TextColor" Value="#14241B" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SmartXFieldBackground}" />
        <Setter Property="TextColor" Value="{StaticResource SmartXAccent}" />
        <Setter Property="BorderColor" Value="{StaticResource SmartXAccent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{StaticResource SmartXTextSecondary}" />
    </Style>

</ResourceDictionary>
