<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartX.Client.SensorRegistrationPage"
             Style="{StaticResource SmartXPage}"
             Title="Sensor Registration"
             Shell.NavBarIsVisible="False">

    <!--
        The width cap sits on the ScrollView rather than on its child. A capped, centred child
        inside a ScrollView is measured against an unconstrained width, so the page lays itself out
        wider and taller than the viewport and the scrollbar stops before the submit button. Capping
        the ScrollView keeps the reading width comfortable on a desktop window and still collapses
        to the full width of a phone screen.
    -->
    <ScrollView HorizontalOptions="Center" MaximumWidthRequest="680">
        <VerticalStackLayout Padding="24,24,24,40" Spacing="20">

            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="BackLink"
                       Grid.Column="0"
                       Text="&#x2190; Back to menu"
                       FontSize="14"
                       TextColor="{StaticResource SmartXAccent}"
                       HorizontalOptions="Start">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Label x:Name="DashboardLink"
                       Grid.Column="1"
                       Text="View Live Dashboard &#x2192;"
                       FontSize="14"
                       TextColor="{StaticResource SmartXAccent}"
                       HorizontalOptions="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label Text="SENSOR DATA INGESTION" Style="{StaticResource SectionLabel}" />
                <Label Text="Register a Sensor" Style="{StaticResource PageTitle}" />
                <Label Style="{StaticResource PageSubtitle}"
                       Text="Attach a node to the deployment tree. The gateway validates the whole estate before accepting it, so any structural problem is reported before the sensor is recorded." />
            </VerticalStackLayout>

            <Border Style="{StaticResource PillarCard}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Device MAC Address / Unique Identifier" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="MacAddressEntry"
                               Style="{StaticResource FormEntry}"
                               Placeholder="A4:CF:12:01:AA:01" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Facility" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="FacilityEntry"
                               Style="{StaticResource FormEntry}"
                               Placeholder="Facility A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Zone" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="ZoneEntry"
                               Style="{StaticResource FormEntry}"
                               Placeholder="Zone 1" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sub-Zone" Style="{StaticResource FieldLabel}" />
                        <Label Text="Optional — leave blank to place the sensor directly in the zone."
                               Style="{StaticResource FieldHint}" />
                        <Entry x:Name="SubZoneEntry"
                               Style="{StaticResource FormEntry}"
                               Placeholder="Sub-Zone B" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sensor Category" Style="{StaticResource FieldLabel}" />
                        <!--
                            No Title is set: a Picker with a Title renders that text instead of the
                            selected item, which left the control looking empty even when a category
                            was chosen. The field label above already says what this control is.
                        -->
                        <Picker x:Name="CategoryPicker"
                                Style="{StaticResource FormPicker}"
                                ItemDisplayBinding="{Binding Display}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Button x:Name="SubmitButton"
                                Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Text="Register Sensor"
                                Clicked="OnSubmitClicked" />
                        <ActivityIndicator x:Name="SubmitSpinner"
                                           Grid.Column="1"
                                           IsVisible="False"
                                           IsRunning="False"
                                           Color="{StaticResource SmartXAccent}"
                                           VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--
                Attaching a file needs a sensor to attach it to, so this section stays hidden until
                a registration succeeds and hands back the identifier the upload endpoint expects.
            -->
            <Border x:Name="AttachmentCard"
                    Style="{StaticResource PillarCard}"
                    IsVisible="False">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Attach a File" Style="{StaticResource PillarTitle}" />
                        <Label x:Name="AttachmentTargetLabel" Style="{StaticResource FieldHint}" />
                        <Label Style="{StaticResource FieldHint}"
                               Text="Optional — a configuration file, deployment photo or hardware log for this sensor." />
                    </VerticalStackLayout>

                    <Button x:Name="ChooseFileButton"
                            Style="{StaticResource SecondaryButton}"
                            Text="Choose File"
                            Clicked="OnChooseFileClicked" />

                    <Grid x:Name="PendingFileRow"
                          IsVisible="False"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="12">
                        <Label x:Name="PickedFileLabel"
                               Grid.Column="0"
                               Style="{StaticResource FieldHint}"
                               LineBreakMode="MiddleTruncation"
                               VerticalOptions="Center" />
                        <Button x:Name="UploadButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Text="Upload"
                                Clicked="OnUploadClicked" />
                        <ActivityIndicator x:Name="UploadSpinner"
                                           Grid.Column="2"
                                           IsVisible="False"
                                           IsRunning="False"
                                           Color="{StaticResource SmartXAccent}"
                                           VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--
                One feedback panel serves both outcomes. The stroke colour carries the success or
                failure signal, and every violation is appended as its own line rather than being
                collapsed into a single sentence.
            -->
            <Border x:Name="FeedbackCard"
                    Style="{StaticResource PillarCard}"
                    IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="FeedbackHeading" Style="{StaticResource PillarTitle}" />
                    <VerticalStackLayout x:Name="FeedbackDetails" Spacing="4" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
