<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartX.Client.LoginPage"
             Style="{StaticResource SmartXPage}"
             Title="Operator Sign In"
             Shell.NavBarIsVisible="False">

    <ScrollView HorizontalOptions="Center" MaximumWidthRequest="680">
        <VerticalStackLayout Padding="24,32,24,40" Spacing="24">

            <Border StrokeThickness="0"
                    HeightRequest="190"
                    StrokeShape="RoundRectangle 22">
                <Image Source="greenhouse_hero.jpg"
                       Aspect="AspectFill"
                       HeightRequest="190" />
            </Border>

            <VerticalStackLayout Spacing="4">
                    <Label Text="SMART-X" Style="{StaticResource SectionLabel}" />
                    <Label Text="Welcome back" Style="{StaticResource PageTitle}" />
                    <Label Style="{StaticResource PageSubtitle}"
                           Text="Use the email and password from the Smart-X Firebase project." />
            </VerticalStackLayout>

            <Border Style="{StaticResource PillarCard}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="UsernameEntry"
                               Style="{StaticResource FormEntry}"
                               Keyboard="Email"
                               Placeholder="operator@smartx.dev" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="PasswordEntry"
                               Style="{StaticResource FormEntry}"
                               IsPassword="True"
                               Placeholder="Firebase password" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Button x:Name="SignInButton"
                                Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Text="Sign in"
                                Clicked="OnSignInClicked" />
                        <ActivityIndicator x:Name="SignInSpinner"
                                           Grid.Column="1"
                                           IsVisible="False"
                                           IsRunning="False"
                                           Color="{StaticResource SmartXAccent}"
                                           VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="FeedbackCard"
                    Style="{StaticResource PillarCard}"
                    IsVisible="False">
                <Label x:Name="FeedbackLabel" Style="{StaticResource PageSubtitle}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

